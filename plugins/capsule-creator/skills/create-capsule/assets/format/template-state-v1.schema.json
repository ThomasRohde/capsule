{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sqlite-capsule.org/schema/template-state-v1.schema.json",
  "title": "Authenticated Capsule template state",
  "description": "Canonical JSON stored in the reserved signed capsule_doc row org.sqlite-capsule.template-state. The native verifier additionally requires exact canonical bytes, BINARY dataset ordering, exhaustive dataset coverage and matching dataset-state digests/counts from the same pinned snapshot.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "app_id",
    "app_version",
    "data_schema_id",
    "data_schema_version",
    "dataset_state_profile",
    "mutable_platform_state_profile",
    "datasets"
  ],
  "properties": {
    "profile": { "const": "org.sqlite-capsule.template-state/1" },
    "app_id": { "type": "string", "minLength": 1, "maxLength": 512, "x-maxUtf8Bytes": 512 },
    "app_version": { "type": "string", "minLength": 1, "maxLength": 128, "x-maxUtf8Bytes": 128 },
    "data_schema_id": { "type": "string", "minLength": 1, "maxLength": 512, "x-maxUtf8Bytes": 512 },
    "data_schema_version": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
    "dataset_state_profile": { "const": "org.sqlite-capsule.dataset-state/1" },
    "mutable_platform_state_profile": { "const": "org.sqlite-capsule.template-platform-reset/1" },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dataset_id", "disposition", "stored_row_count", "state_sha256"],
        "properties": {
          "dataset_id": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]{0,255}$",
            "x-maxUtf8Bytes": 256
          },
          "disposition": { "enum": ["seed", "empty"] },
          "stored_row_count": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
          "state_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
