{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sqlite-capsule.org/schema/upgrade-plan-v1.schema.json",
  "title": "Capsule same-schema application-upgrade review",
  "description": "Bounded review evidence for a create-new M07 rebase. This serializable projection grants no execution authority; the host retains the exact inputs, destination reservation and canonical lifecycle plan.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile", "source", "target_release", "output", "publisher_continuity",
    "capability_delta", "target_template_state_sha256", "dataset_actions",
    "lineage", "limits", "review_digest"
  ],
  "properties": {
    "profile": { "const": "org.sqlite-capsule.upgrade-plan/1" },
    "source": { "$ref": "#/$defs/input" },
    "target_release": { "$ref": "#/$defs/input" },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capsule_id", "revision_id", "app_id", "app_version", "application_digest", "data_schema_id", "data_schema_version", "publish_mode"],
      "properties": {
        "capsule_id": { "$ref": "#/$defs/nonempty" },
        "revision_id": { "$ref": "#/$defs/nonempty" },
        "app_id": { "$ref": "#/$defs/nonempty" },
        "app_version": { "$ref": "#/$defs/semver" },
        "application_digest": { "$ref": "#/$defs/sha256" },
        "data_schema_id": { "$ref": "#/$defs/nonempty" },
        "data_schema_version": { "type": "integer", "minimum": 1 },
        "publish_mode": { "const": "create-new-no-replace" }
      }
    },
    "publisher_continuity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "accepted_key_id", "source_inventory_sha256", "target_inventory_sha256"],
      "properties": {
        "state": { "const": "same-accepted-key" },
        "accepted_key_id": { "$ref": "#/$defs/nonempty" },
        "source_inventory_sha256": { "$ref": "#/$defs/sha256" },
        "target_inventory_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "capability_delta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["added", "removed", "changed", "source_permissions_sha256", "target_permissions_sha256", "requires_review"],
      "properties": {
        "added": { "$ref": "#/$defs/string_set" },
        "removed": { "$ref": "#/$defs/string_set" },
        "changed": { "$ref": "#/$defs/string_set" },
        "source_permissions_sha256": { "$ref": "#/$defs/sha256" },
        "target_permissions_sha256": { "$ref": "#/$defs/sha256" },
        "requires_review": { "type": "boolean" }
      }
    },
    "target_template_state_sha256": { "$ref": "#/$defs/sha256" },
    "dataset_actions": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["dataset_id", "policy", "action", "source", "target", "expected"],
        "properties": {
          "dataset_id": { "$ref": "#/$defs/nonempty" },
          "policy": { "enum": ["copy", "target", "rebuild", "omit"] },
          "action": { "enum": ["copy", "take-target", "rebuild", "omit"] },
          "source": { "$ref": "#/$defs/dataset_state" },
          "target": { "$ref": "#/$defs/dataset_state" },
          "expected": { "$ref": "#/$defs/dataset_state" }
        }
      }
    },
    "lineage": {
      "type": "object", "additionalProperties": false,
      "required": ["event_id", "operation", "occurred_at", "working_relation", "release_relation"],
      "properties": {
        "event_id": { "$ref": "#/$defs/nonempty" },
        "operation": { "const": "application-upgrade" },
        "occurred_at": { "type": "string", "format": "date-time" },
        "working_relation": { "const": "upgraded-from" },
        "release_relation": { "const": "application-release" }
      }
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["max_input_bytes", "max_output_bytes", "max_rows_written", "deadline_ms"],
      "properties": {
        "max_input_bytes": { "type": "integer", "minimum": 1 },
        "max_output_bytes": { "type": "integer", "minimum": 1 },
        "max_rows_written": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "deadline_ms": { "type": "integer", "minimum": 1, "maximum": 30000 }
      }
    },
    "review_digest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nonempty": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "semver": { "type": "string", "maxLength": 128, "x-maxUtf8Bytes": 128, "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$" },
    "string_set": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/nonempty" } },
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["file_sha256", "capsule_id", "revision_id", "app_id", "app_version", "application_digest", "publisher_key_id", "signature_inventory_sha256", "signature_count", "data_schema_id", "data_schema_version"],
      "properties": {
        "file_sha256": { "$ref": "#/$defs/sha256" },
        "capsule_id": { "$ref": "#/$defs/nonempty" },
        "revision_id": { "$ref": "#/$defs/nonempty" },
        "app_id": { "$ref": "#/$defs/nonempty" },
        "app_version": { "$ref": "#/$defs/semver" },
        "application_digest": { "$ref": "#/$defs/sha256" },
        "publisher_key_id": { "$ref": "#/$defs/nonempty" },
        "signature_inventory_sha256": { "$ref": "#/$defs/sha256" },
        "signature_count": { "type": "integer", "minimum": 1 },
        "data_schema_id": { "$ref": "#/$defs/nonempty" },
        "data_schema_version": { "type": "integer", "minimum": 1 }
      }
    },
    "dataset_state": {
      "type": "object", "additionalProperties": false,
      "required": ["profile", "row_count", "state_sha256"],
      "properties": {
        "profile": { "const": "org.sqlite-capsule.dataset-state/1" },
        "row_count": { "type": "integer", "minimum": 0 },
        "state_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
