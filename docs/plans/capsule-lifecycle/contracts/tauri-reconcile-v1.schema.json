{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sqlite-capsule.org/schema/tauri-reconcile-v1.schema.json",
  "title": "Trusted-shell reconciliation requests and projections",
  "description": "Strict bounded main-shell reconciliation contract. Every input authority is opaque; filesystem paths, SQLite identifiers, row keys, row values, digests used as authority and SQL remain in Rust.",
  "oneOf": [
    {"$ref": "#/$defs/options_request"},
    {"$ref": "#/$defs/start_request"},
    {"$ref": "#/$defs/session_request"},
    {"$ref": "#/$defs/choose_ancestor_request"},
    {"$ref": "#/$defs/prepare_two_way_request"},
    {"$ref": "#/$defs/prepare_three_way_request"},
    {"$ref": "#/$defs/execute_request"},
    {"$ref": "#/$defs/operation_request"},
    {"$ref": "#/$defs/options"},
    {"$ref": "#/$defs/session"},
    {"$ref": "#/$defs/destination"},
    {"$ref": "#/$defs/three_way"},
    {"$ref": "#/$defs/prepared"},
    {"$ref": "#/$defs/progress"},
    {"$ref": "#/$defs/status"}
  ],
  "$defs": {
    "token": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "label": {"type": "string", "minLength": 1, "maxLength": 512},
    "action": {"enum": ["insert-from-source", "delete-from-target", "replace-row-from-source", "set-fields"]},
    "phase": {"enum": ["queued", "reverify", "stage", "transform", "validate", "publish", "postpublish", "succeeded", "failed", "cancelled"]},
    "options_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_token"],
      "properties": {"session_token": {"$ref": "#/$defs/token"}}
    },
    "start_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["orientation_token"],
      "properties": {"orientation_token": {"$ref": "#/$defs/token"}}
    },
    "session_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review_token"],
      "properties": {"review_token": {"$ref": "#/$defs/token"}}
    },
    "choose_ancestor_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review_token", "destination_token"],
      "properties": {
        "review_token": {"$ref": "#/$defs/token"},
        "destination_token": {"$ref": "#/$defs/token"}
      }
    },
    "prepare_two_way_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review_token", "destination_token", "selection_tokens"],
      "properties": {
        "review_token": {"$ref": "#/$defs/token"},
        "destination_token": {"$ref": "#/$defs/token"},
        "selection_tokens": {"type": "array", "minItems": 1, "maxItems": 10000, "uniqueItems": true, "items": {"$ref": "#/$defs/token"}},
        "ancestor_token": {"type": "null"},
        "resolution_tokens": {"type": "array", "maxItems": 0}
      }
    },
    "prepare_three_way_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review_token", "destination_token", "ancestor_token", "resolution_tokens"],
      "properties": {
        "review_token": {"$ref": "#/$defs/token"},
        "destination_token": {"$ref": "#/$defs/token"},
        "selection_tokens": {"type": "array", "maxItems": 0},
        "ancestor_token": {"$ref": "#/$defs/token"},
        "resolution_tokens": {"type": "array", "maxItems": 10000, "uniqueItems": true, "items": {"$ref": "#/$defs/token"}}
      }
    },
    "execute_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confirmation_nonce"],
      "properties": {"confirmation_nonce": {"$ref": "#/$defs/token"}}
    },
    "operation_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_token"],
      "properties": {"operation_token": {"$ref": "#/$defs/token"}}
    },
    "orientation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["orientation_token", "source_label", "target_label", "result_label"],
      "properties": {
        "orientation_token": {"$ref": "#/$defs/token"},
        "source_label": {"$ref": "#/$defs/label"},
        "target_label": {"$ref": "#/$defs/label"},
        "result_label": {"const": "New copy of target"}
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "orientations", "disclosed_change_count", "sensitive_change_count", "blockers"],
      "properties": {
        "profile": {"const": "org.sqlite-capsule.tauri-reconcile-options/1"},
        "orientations": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/orientation"}},
        "disclosed_change_count": {"type": "integer", "minimum": 0, "maximum": 10000},
        "sensitive_change_count": {"type": "integer", "minimum": 0, "maximum": 10000},
        "blockers": {"type": "array", "maxItems": 2, "uniqueItems": true, "items": {"enum": ["comparison-not-reconcilable", "review-row-detail-first"]}}
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selection_token", "dataset_label", "table_label", "action", "field_count", "sensitivity", "sensitive_reveal_confirmed"],
      "properties": {
        "selection_token": {"$ref": "#/$defs/token"},
        "dataset_label": {"$ref": "#/$defs/label"},
        "table_label": {"$ref": "#/$defs/label"},
        "action": {"$ref": "#/$defs/action"},
        "field_count": {"type": "integer", "minimum": 0, "maximum": 256},
        "sensitivity": {"enum": ["normal", "sensitive"]},
        "sensitive_reveal_confirmed": {"type": "boolean"}
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "review_token", "source_label", "target_label", "output_capsule_id", "output_application_digest", "output_signature_count", "selections", "expires_at", "checks"],
      "properties": {
        "profile": {"const": "org.sqlite-capsule.tauri-reconcile-session/1"},
        "review_token": {"$ref": "#/$defs/token"},
        "source_label": {"$ref": "#/$defs/label"},
        "target_label": {"$ref": "#/$defs/label"},
        "output_capsule_id": {"$ref": "#/$defs/uuid"},
        "output_application_digest": {"$ref": "#/$defs/digest"},
        "output_signature_count": {"type": "integer", "minimum": 1, "maximum": 1024},
        "selections": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/selection"}},
        "expires_at": {"type": "string", "format": "date-time"},
        "checks": {"type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": {"type": "string", "maxLength": 64}}
      }
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["destination_token", "parent_display", "leaf_display", "expires_at"],
      "properties": {
        "destination_token": {"$ref": "#/$defs/token"},
        "parent_display": {"type": "string", "minLength": 1, "maxLength": 64},
        "leaf_display": {"$ref": "#/$defs/label"},
        "expires_at": {"type": "string", "format": "date-time"}
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capsule_id", "revision_id", "application_digest", "signature_count", "data_schema_id", "data_schema_version"],
      "properties": {
        "capsule_id": {"$ref": "#/$defs/uuid"},
        "revision_id": {"$ref": "#/$defs/uuid"},
        "application_digest": {"$ref": "#/$defs/digest"},
        "signature_count": {"type": "integer", "minimum": 1, "maximum": 1024},
        "data_schema_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "data_schema_version": {"type": "integer", "minimum": 1}
      }
    },
    "resolution_choice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resolution_token", "choice"],
      "properties": {
        "resolution_token": {"$ref": "#/$defs/token"},
        "choice": {"enum": ["keep-target", "take-source"]}
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conflict_token", "dataset_label", "table_label", "kind", "choices"],
      "properties": {
        "conflict_token": {"$ref": "#/$defs/token"},
        "dataset_label": {"$ref": "#/$defs/label"},
        "table_label": {"$ref": "#/$defs/label"},
        "kind": {"enum": ["insert-insert", "update-update", "delete-update", "immutable-field"]},
        "deleted_side": {"enum": ["source", "target"]},
        "choices": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/resolution_choice"}}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "delete-update"}}, "required": ["kind"]}, "then": {"required": ["deleted_side"]}, "else": {"not": {"required": ["deleted_side"]}}},
        {
          "if": {"properties": {"kind": {"const": "immutable-field"}}, "required": ["kind"]},
          "then": {
            "properties": {
              "choices": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "prefixItems": [{"type": "object", "properties": {"choice": {"const": "keep-target"}}}]
              }
            }
          },
          "else": {
            "properties": {
              "choices": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "prefixItems": [
                  {"type": "object", "properties": {"choice": {"const": "keep-target"}}},
                  {"type": "object", "properties": {"choice": {"const": "take-source"}}}
                ]
              }
            }
          }
        }
      ]
    },
    "three_way": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "ancestor_token", "ancestor", "clean_change_count", "conflicts", "expires_at"],
      "properties": {
        "profile": {"const": "org.sqlite-capsule.tauri-reconcile-three-way/1"},
        "ancestor_token": {"$ref": "#/$defs/token"},
        "ancestor": {"$ref": "#/$defs/reference"},
        "clean_change_count": {"type": "integer", "minimum": 0, "maximum": 10000},
        "conflicts": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/conflict"}},
        "expires_at": {"type": "string", "format": "date-time"}
      }
    },
    "operation_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "dataset_label", "table_label", "action", "field_count", "sensitive_confirmed"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1, "maximum": 10000},
        "dataset_label": {"$ref": "#/$defs/label"},
        "table_label": {"$ref": "#/$defs/label"},
        "action": {"$ref": "#/$defs/action"},
        "field_count": {"type": "integer", "minimum": 0, "maximum": 256},
        "sensitive_confirmed": {"type": "boolean"}
      }
    },
    "prepared": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "confirmation_nonce", "review_digest", "payload_digest", "compare_report_digest", "source", "target", "output", "operation_count", "operations", "lineage_parent_count", "destination", "checks", "expires_at"],
      "properties": {
        "profile": {"const": "org.sqlite-capsule.tauri-reconcile-review/1"},
        "confirmation_nonce": {"$ref": "#/$defs/token"},
        "review_digest": {"$ref": "#/$defs/digest"},
        "payload_digest": {"$ref": "#/$defs/digest"},
        "compare_report_digest": {"$ref": "#/$defs/digest"},
        "source": {"$ref": "#/$defs/reference"},
        "target": {"$ref": "#/$defs/reference"},
        "output": {"$ref": "#/$defs/reference"},
        "operation_count": {"type": "integer", "minimum": 1, "maximum": 10000},
        "operations": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"$ref": "#/$defs/operation_review"}},
        "lineage_parent_count": {"const": 2},
        "destination": {"$ref": "#/$defs/destination"},
        "checks": {"type": "array", "minItems": 9, "maxItems": 9, "uniqueItems": true, "items": {"type": "string", "maxLength": 64}},
        "expires_at": {"type": "string", "format": "date-time"}
      }
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "operation_token", "sequence", "phase", "cancellable"],
      "properties": {
        "profile": {"const": "org.sqlite-capsule.tauri-reconcile-status/1"},
        "operation_token": {"$ref": "#/$defs/token"},
        "sequence": {"type": "integer", "minimum": 0},
        "phase": {"$ref": "#/$defs/phase"},
        "cancellable": {"type": "boolean"}
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "code", "category", "retryable", "safe_detail"],
      "properties": {
        "profile": {"const": "org.sqlite-capsule.lifecycle-errors/1"},
        "code": {"type": "string", "minLength": 1, "maxLength": 64},
        "category": {"type": "string", "minLength": 1, "maxLength": 64},
        "retryable": {"type": "boolean"},
        "safe_detail": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "operation_token", "phase", "cancellable", "output_leaf"],
      "properties": {
        "profile": {"const": "org.sqlite-capsule.tauri-reconcile-status/1"},
        "operation_token": {"$ref": "#/$defs/token"},
        "phase": {"$ref": "#/$defs/phase"},
        "cancellable": {"type": "boolean"},
        "output_leaf": {"$ref": "#/$defs/label"},
        "output_bytes": {"type": "integer", "minimum": 0, "maximum": 67108864},
        "error": {"$ref": "#/$defs/error"}
      }
    }
  }
}
