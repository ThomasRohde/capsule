{
  "name": "sqlite-capsule-regression",
  "private": true,
  "version": "0.4.2",
  "description": "Pinned development-only browser acceptance for the offline Diagram Studio capsule.",
  "scripts": {
    "test:browser": "playwright test --config tests/browser/playwright.config.mjs",
    "test:browser:update": "playwright test --config tests/browser/playwright.config.mjs --update-snapshots",
    "test:browser:html": "playwright test --config tests/browser-html/playwright.config.mjs",
    "test:browser:html:chromium": "playwright test --config tests/browser-html/playwright.config.mjs --project chromium",
    "test:browser:html:update": "playwright test --config tests/browser-html/playwright.config.mjs --project chromium --update-snapshots",
    "test:native:prepare": "python native/tools/prepare_native_e2e.py",
    "test:native:prepare:check": "python native/tools/prepare_native_e2e.py --check",
    "test:native": "wdio run tests/native/wdio.conf.mjs",
    "test:native:overview": "node tests/native/cabinet-overview.e2e.mjs",
    "test:native:window": "node tests/native/standalone-window.e2e.mjs",
    "test:native:raw": "node tests/native/raw-child.e2e.mjs",
    "test:native:reconcile": "node tests/native/reconcile.e2e.mjs",
    "test:native:reconcile-finalization": "node tests/native/reconcile-finalization.test.mjs",
    "test:native:upgrade": "node tests/native/upgrade.e2e.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@sqlite.org/sqlite-wasm": "3.53.0-build1",
    "@wdio/cli": "9.30.1",
    "@wdio/jasmine-framework": "9.30.1",
    "@wdio/local-runner": "9.30.1",
    "@wdio/spec-reporter": "9.30.1"
  }
}
