{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SQLite Capsule Host",
  "version": "0.2.0",
  "identifier": "org.sqlite-capsule.host",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SQLite Capsule Host — trust review",
        "width": 1180,
        "height": 760,
        "minWidth": 760,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "devtools": false
      }
    ],
    "security": {
      "capabilities": ["host-shell"],
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; frame-src 'none'; connect-src 'none'; font-src 'none'; media-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [],
      "pubkey": ""
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["sqlitecapsule"],
        "contentTypes": ["org.sqlite-capsule.capsule"],
        "name": "SQLite Capsule",
        "description": "Self-describing SQLite Capsule application",
        "role": "Editor",
        "mimeType": "application/vnd.sqlite-capsule",
        "rank": "Owner",
        "exportedType": {
          "identifier": "org.sqlite-capsule.capsule",
          "conformsTo": ["public.database", "public.data"]
        }
      }
    ],
    "windows": {
      "allowDowngrades": true,
      "wix": {
        "fragmentPaths": ["./windows/fragments/installer-cache.wxs"],
        "componentRefs": ["SQLiteCapsuleInstallerCache"]
      },
      "nsis": {
        "installerHooks": "./windows/installer-hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
