{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sqlite-capsule.org/schema/capsule-lineage-v0.3.schema.json",
  "title": "SQLite Capsule mutable lineage report",
  "description": "Bounded redacted projection of mutable, unauthenticated lineage claims. Raw details_json is never included.",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "capsule_id", "provenance_status", "events"],
  "properties": {
    "profile": {"const": "org.sqlite-capsule.lineage/0.3"},
    "capsule_id": {"$ref": "#/$defs/uuid"},
    "provenance_status": {"const": "mutable-untrusted"},
    "events": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/event"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "sequence", "operation", "result_capsule_id", "result_revision_id", "occurred_at", "application_digest", "data_schema_id", "data_schema_version", "plan_digest", "details_sha256", "details_property_count", "details_redacted", "parents"],
      "properties": {
        "event_id": {"$ref": "#/$defs/uuid"},
        "sequence": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "operation": {"enum": ["created", "created-from-template", "fork", "reconcile", "application-upgrade", "import"]},
        "result_capsule_id": {"$ref": "#/$defs/uuid"},
        "result_revision_id": {"$ref": "#/$defs/uuid"},
        "occurred_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "application_digest": {"$ref": "#/$defs/sha256"},
        "data_schema_id": {"type": "string", "minLength": 1, "maxLength": 512, "x-maxUtf8Bytes": 512},
        "data_schema_version": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "plan_digest": {"$ref": "#/$defs/sha256"},
        "details_sha256": {"$ref": "#/$defs/sha256"},
        "details_property_count": {"type": "integer", "minimum": 0, "maximum": 64},
        "details_redacted": {"const": true},
        "parents": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/parent"}}
      }
    },
    "parent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relation", "capsule_id", "revision_id", "file_sha256"],
      "properties": {
        "relation": {"enum": ["created-from", "forked-from", "target-derived-from", "changes-applied-from", "upgraded-from", "application-release"]},
        "capsule_id": {"oneOf": [{"$ref": "#/$defs/uuid"}, {"type": "null"}]},
        "revision_id": {"oneOf": [{"$ref": "#/$defs/uuid"}, {"type": "null"}]},
        "file_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
