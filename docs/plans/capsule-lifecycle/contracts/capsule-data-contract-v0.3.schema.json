{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sqlite-capsule.org/schema/capsule-data-contract-v0.3.schema.json",
  "title": "SQLite Capsule v0.3 verified data-contract projection",
  "description": "Bounded public projection of the signed capsule_dataset declarations after verification against actual SQLite schema metadata. Every actual cross-dataset foreign key is covered by a child-to-parent dependency and uses only NO ACTION or RESTRICT in the initial lifecycle profile.",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "app_id", "data_schema_id", "data_schema_version", "datasets"],
  "properties": {
    "profile": {"const": "org.sqlite-capsule.data-contract/0.3"},
    "app_id": {"type": "string", "minLength": 1, "maxLength": 512, "x-maxUtf8Bytes": 512},
    "data_schema_id": {"type": "string", "minLength": 1, "maxLength": 512, "x-maxUtf8Bytes": 512},
    "data_schema_version": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "datasets": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/dataset"}}
  },
  "$defs": {
    "dataset_id": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]{0,255}$", "x-maxUtf8Bytes": 256},
    "sqlite_identifier": {"type": "string", "minLength": 1, "maxLength": 256, "x-maxUtf8Bytes": 256},
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "description", "sensitivity", "required", "fork", "compare", "reconcile", "upgrade", "tables", "dependencies"],
      "properties": {
        "id": {"$ref": "#/$defs/dataset_id"},
        "role": {"enum": ["seed", "user-content", "settings", "history", "derived", "cache"]},
        "description": {"type": "string", "minLength": 1, "maxLength": 2048, "x-maxUtf8Bytes": 2048},
        "sensitivity": {"enum": ["normal", "sensitive"]},
        "required": {"type": "boolean"},
        "fork": {"enum": ["copy", "reset", "omit", "prompt", "forbid"]},
        "compare": {"enum": ["ignore", "summary", "row", "field"]},
        "reconcile": {"enum": ["ignore", "manual", "three-way", "forbid"]},
        "upgrade": {"enum": ["copy", "target", "migrate", "rebuild", "omit", "forbid"]},
        "tables": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/table"}},
        "dependencies": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/dependency"}}
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sequence", "primary_key", "ignored_columns", "immutable_columns"],
      "properties": {
        "name": {"$ref": "#/$defs/sqlite_identifier"},
        "sequence": {"type": "integer", "minimum": 0, "maximum": 65535},
        "primary_key": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/sqlite_identifier"}},
        "ignored_columns": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/sqlite_identifier"}},
        "immutable_columns": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/sqlite_identifier"}}
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_id", "reason"],
      "properties": {
        "dataset_id": {"$ref": "#/$defs/dataset_id"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 2048, "x-maxUtf8Bytes": 2048}
      }
    }
  }
}
